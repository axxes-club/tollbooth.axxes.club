# ─── Shared AXXES database (same as members.axxes.club) ───────────────────────────
DATABASE_URL=
# Must match members.axxes.club so both apps accept the same credentials
BETTER_AUTH_SECRET=
# Public URL of this app, e.g. https://tollbooth.axxes.club
BETTER_AUTH_URL=
# Central AXXES sign-in. Leave unset to use this app's own sign-in page.
HANDSHAKE_URL=
# Share one session across every *.axxes.club app
AUTH_COOKIE_DOMAIN=.axxes.club

# ─── Tollbooth ──────────────────────────────────────────────────────────────────
# Live platform key. Starts a real Stripe Connect account per workspace.
STRIPE_SECRET_KEY=
# Test platform key. Required for test-mode keys to work; must be a sk_test_ key.
STRIPE_SECRET_KEY_TEST=
# Webhook signing secret(s) for /api/webhooks/stripe, comma-separated.
# One for the platform endpoint, one for the Connect (account.updated) endpoint.
STRIPE_WEBHOOK_SECRET=
# Guards POST /api/cron/deliveries. Vercel cron sends this if CRON_SECRET is set.
CRON_SECRET=
# Tollbooth's own fee: basis points + fixed minor units. 100 bps = 1%.
TOLLBOOTH_FEE_BPS=100
TOLLBOOTH_FEE_FIXED=0
# Used for absolute URLs in emails, webhook examples and the SDK page.
TOLLBOOTH_SITE_URL=https://tollbooth.axxes.club
