{
  "name": "@tollbooth/sdk",
  "version": "1.0.0",
  "description": "Zero-dependency JavaScript client for the Tollbooth payment API",
  "type": "module",
  "main": "./tollbooth.mjs",
  "module": "./tollbooth.mjs",
  "types": "./tollbooth.d.ts",
  "exports": {
    ".": {
      "types": "./tollbooth.d.ts",
      "import": "./tollbooth.mjs",
      "default": "./tollbooth.mjs"
    }
  },
  "files": ["tollbooth.mjs", "tollbooth.d.ts", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "license": "MIT",
  "keywords": ["payments", "checkout", "stripe-alternative", "axxes"]
}
